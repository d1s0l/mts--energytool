POSTGRES_PASSWORD=energytool
KNOWLEDGE_BASE_PATH=/absolute/path/to/knowledge-base.zip
RAG_MODE=local
MAX_WORKERS=3
# Remote generation with the Immers public API:
LLM_BASE_URL=https://chat.immers.cloud/v1/endpoints/generate
LLM_API_KEY=
# RAG_MODE=local uses no embedding API. Platform embedding settings:
# EMB_MODEL=BAAI/bge-m3
# RERANKER_MODEL=

# Immers API alias, not the repository name of the quantized weights:
LLM_MODEL=qwen3.8-27b
# TEMPERATURE=0
# MAX_TOKENS=1600
# LLM_TIMEOUT=20
